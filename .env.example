# Copy to .env.local (and set the same values in Vercel project settings).

# Postgres connection string (Supabase: use the transaction pooler URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Clerk keys: must be the SAME Clerk application as the CommonGroundUI frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Browser origins allowed to call the API directly (comma separated).
# The frontend normally goes through its own /api/proxy, which needs no CORS.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_ORIGINS=""

# Any long random string. Used so anonymous authors can't be identified.
ANON_SALT="change-me"

# Only for `npm test`: an EMPTY database the tests may wipe.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/cg_test"
