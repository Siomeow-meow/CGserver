// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id                String                     @id @default(uuid())
  email             String                     @unique
  userName          String                     @unique
  bio               String?
  fName             String?
  lName             String?
  profileImg        String?
  bannerImg         String?
  savedPosts        SavedPost[]
  notifications     Notification[]             @relation("NotificationsReceived")
  notificationsSent Notification[]             @relation("NotificationsSent")
  posts             Post[]
  comments          Comment[]
  likedPost         PostLike[]
  likedComments     CommentLike[]
  conversations     ConversationParticipant[]
  groupMemberships  GroupMember[]
  sentRequests      Friend[]                   @relation("SentFriendReq")
  receivedRequests  Friend[]                   @relation("ReceivedFriendReq")
  senderMessages    Message[]                  @relation("SenderMessages")
}
model Post { 
  id             Int       @id @default(autoincrement()) 
  title          String
  content        String?
  tags           String[]
  images         String[]
  createdAt      DateTime  @default(now())
  status         String    @default("draft")
  isAnonymous    Boolean   @default(false)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade) 
  viewers        Viewers[]
  comments       Comment[]
  likedPost      PostLike[]
  savedBy        SavedPost[]
  groupId        Int?
  group          Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
}
model Comment {
  id           Int            @id @default(autoincrement())
  content      String
  createdAt    DateTime       @default(now())
  commenterId  String
  commenter    User           @relation(fields: [commenterId], references: [id], onDelete: Cascade)
  postId       Int
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes        CommentLike[]

  parentId    Int?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
}
model Group{ 
  id               Int      @id @default(autoincrement())
  groupName        String   @unique
  description      String   @default("")
  groupImg         String
  bannerImg        String
  groupThemes      String[]
  allowAnonymity   Boolean  @default(false)
  posts            Post[]
  groupMembers     GroupMember[]
}
model GroupMember{
  memberId  String
  member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  role      String   @default("member")

  @@id([memberId, groupId])
}
model Notification {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  type       String
  content    String
  link       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
model Friend {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime @default(now())
  status      String   @default("PENDING")
  userId      String
  user        User      @relation("SentFriendReq", fields: [userId], references: [id], onDelete: Cascade) 
  receiverId  String
  receiver    User     @relation("ReceivedFriendReq", fields: [receiverId], references: [id], onDelete: Cascade)
  @@unique([userId, receiverId]) 
}
model Viewers {
  id         Int       @id @default(autoincrement())
  postId     Int
  viewerId   String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([postId, viewerId])
}
model PostLike {
  id         Int       @id @default(autoincrement())
  type       String
  postId     Int
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade) 
  likerId    String
  liker      User     @relation(fields: [likerId], references: [id], onDelete: Cascade)
  @@unique([postId, likerId])
}
model CommentLike {
  id         Int       @id @default(autoincrement())
  type       String
  commentId  Int
  comment    Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  likerId    String
  liker      User     @relation(fields: [likerId], references: [id], onDelete: Cascade)
  @@unique([commentId, likerId])
}
model Message {
  id          Int           @id @default(autoincrement())
  content     String
  createdAt   DateTime      @default(now())
  conversationId Int
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)

  parentId    Int?
  parent      Message?      @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]     @relation("MessageReplies")
  @@unique([senderId, createdAt])
}
model Conversation {
  id            Int @id @default(autoincrement())
  isGroup       Boolean
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  conversationId  Int
  participantId   String
  lastReadAt      DateTime?

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participant     User         @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([conversationId, participantId])
}

model SavedPost {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}
